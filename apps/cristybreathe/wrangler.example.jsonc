{
  "name": "your-private-workspace",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{"binding":"DB","database_name":"your-private-database","database_id":"REPLACE_PRIVATELY"}],
  "vars": {
    "ACCESS_ISSUER": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR-ACCESS-APPLICATION-AUDIENCE",
    "ALLOWED_EMAILS": "owner@example.com,second@example.com"
  }
}
