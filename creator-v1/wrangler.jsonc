{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anevum-creator-v1",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "anevum.com/*", "zone_name": "anevum.com" }],
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "anevum-community-preview",
    "database_id": "6c7b5f0c-33db-4b6a-9569-0a6af5e07534",
    "migrations_dir": "../community-preview/migrations"
  }]
}
