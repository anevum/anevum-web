{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anevum-community-preview",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "next.anevum.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMUNITY_DB",
      "database_name": "anevum-creator-v1-staging",
      "database_id": "fa96e36d-6257-4883-bf15-074947e11a13",
      "migrations_dir": "../community-preview/migrations"
    }
  ]
}
