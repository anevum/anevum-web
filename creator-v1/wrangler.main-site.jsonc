{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anevum-creator-v1-main",
  "main": "./web/main-worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "anevum-community-preview",
    "database_id": "6c7b5f0c-33db-4b6a-9569-0a6af5e07534"
  }]
}
