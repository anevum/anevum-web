{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anevum-first-contact-v133-review",
  "main": "./web/first-contact-review-v133.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
