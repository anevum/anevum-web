{
  // UNROUTED SOURCE-ONLY REVIEW CONFIG.
  // Do not replace the live a.anevum.com Worker or enable public uploads.
  // Bind an isolated, newly provisioned R2 bucket; never reuse CREATOR_ASSETS.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "anevum-creator-large-review-inactive",
  "account_id": "2f7ee83107240152097efd956a4e8335",
  "main": "./web/a-canonical-stage.review.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "COMMUNITY_DB",
      "database_name": "anevum-creator-v1-staging",
      "database_id": "fa96e36d-6257-4883-bf15-074947e11a13"
    },
    {
      "binding": "MEMBER_DB",
      "database_name": "anevum-canonical-member-staging",
      "database_id": "e1d29049-c83b-4534-8355-dc1fa36ba6d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CREATOR_LARGE_ASSETS",
      "bucket_name": "anevum-creator-large-assets-review"
    }
  ],
  "vars": {
    "ANEVUM_CANONICAL_STAGE_ENABLED": "false",
    "CANONICAL_SCHEMA_APPROVED": "false",
    "CANONICAL_CREATOR_STUDIO_ENABLED": "false",
    "CANONICAL_CREATOR_UPLOADS_ENABLED": "false",
    "CANONICAL_CREATOR_LARGE_UPLOADS_ENABLED": "false",
    "CANONICAL_CREATOR_LARGE_ACCESS": "pilot",
    "CANONICAL_INVITED_SIGNUP_ENABLED": "false",
    "CANONICAL_PUBLIC_SIGNUP_ENABLED": "false",
    "CANONICAL_GOOGLE_ENABLED": "false",
    "CANONICAL_EMAIL_ENABLED": "false"
  }
}
