{
  "name": "anevum-member-auth-staging",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "next.anevum.com/api/v1/member/*", "zone_name": "anevum.com" }],
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "anevum-creator-v1-staging",
    "database_id": "fa96e36d-6257-4883-bf15-074947e11a13"
  }],
  "triggers": {"crons":["30 3 * * *"]}
}