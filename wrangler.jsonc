{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anevum-web-nextgen",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "anevum.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
