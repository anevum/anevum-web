{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anevum-web-nextgen",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "vars": {
    "COMMAND_AUTH_MODE": "cloudflare_access",
    "CF_ACCESS_TEAM_DOMAIN": "https://wispy-tooth-095a.cloudflareaccess.com",
    "CF_ACCESS_AUD": "3fabe3c703b4cc972136d2292fda39783c11903c3c6cf5ac0e42c4738f2ee800",
    "COMMAND_ACCESS_EMAILS": "devon@anevum.com",
    "COMMAND_LIVE_STREAM_ENABLED": "false",
    "ANEVUM_MEMBERS_ENABLED": "false",
    "ANEVUM_MEMBER_PREVIEW_ENABLED": "false"
  },
  "routes": [
    {
      "pattern": "anevum.com/*",
      "zone_name": "anevum.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
