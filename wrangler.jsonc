{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anevum-web-nextgen",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "anevum.com/*",
      "zone_name": "anevum.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
