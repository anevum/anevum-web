{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anevum-member-staging",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "COMMAND_AUTH_MODE": "cloudflare_access",
    "COMMAND_LIVE_STREAM_ENABLED": "false",
    "ANEVUM_MEMBERS_ENABLED": "true",
    "ANEVUM_MEMBER_RHEN_DRAFTS_ENABLED": "true",
    "ANEVUM_MEMBER_PREVIEW_ENABLED": "true",
    "MEMBER_PREVIEW_ORIGIN": "https://anevum-member-staging.devonakins.workers.dev",
    "ANEVUM_RHEN_BILLING_ENABLED": "true",
    "ANEVUM_RHEN_BILLING_CHECKOUT_ENABLED": "false",
    "ANEVUM_RHEN_BILLING_WEBHOOKS_ENABLED": "true",
    "ANEVUM_RHEN_FOUNDING_ENABLED": "false",
    "ANEVUM_RHEN_BILLING_LIVE_APPROVED": "false",
    "ANEVUM_STRIPE_MODE": "test",
    "ANEVUM_RHEN_BETA_WAITLIST_ENABLED": "false",
    "STRIPE_FOUNDING_PRICE_ID": "price_1UOcwSDSvwYS3kwTHxrYRQev",
    "STRIPE_STANDARD_PRICE_ID": "price_1UOcwYDSvwYS3kwTqnadIMBD"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "MEMBER_DB",
      "database_name": "anevum-members-preview",
      "database_id": "a537432e-d216-4b31-8b22-19662cc3a44a",
      "migrations_dir": "migrations"
    }
  ]
}
