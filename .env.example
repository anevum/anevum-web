# RHENLINK / member backend
VITE_SUPABASE_URL=https://mfntzxheldzdvlokyntk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted by src/memberClient.ts as a fallback:
# VITE_SUPABASE_ANON_KEY=

# Public REPLY launch state
VITE_REPLY_RELEASE_LABEL=
# Purchase destinations must be full HTTPS URLs.
VITE_REPLY_BUY_URL=
VITE_REPLY_HARDCOVER_URL=
VITE_REPLY_PAPERBACK_URL=
VITE_REPLY_EBOOK_URL=
# Sample and image assets may be HTTPS URLs or same-origin absolute paths beginning with /.
VITE_REPLY_SAMPLE_URL=
VITE_REPLY_COVER_URL=
VITE_REPLY_HERO_IMAGE_URL=

# Public legal/contact identity. These values are browser-visible by design.
# Use only owner-approved public information; never put secrets here.
VITE_PUBLIC_LEGAL_NAME=
VITE_PUBLIC_SUPPORT_EMAIL=
VITE_PUBLIC_PRIVACY_EMAIL=
VITE_PUBLIC_MAILING_ADDRESS=
# Account request destination may be an HTTPS URL or same-origin absolute path beginning with /.
VITE_PUBLIC_ACCOUNT_REQUEST_URL=
VITE_PUBLIC_MINIMUM_AGE=13

# Privacy-light product analytics. Leave blank to disable analytics completely.
# This is a PostHog browser project token, not a server/private API key.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
