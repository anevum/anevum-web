{
  "name": "anevum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "canon:validate": "node scripts/sync-canon-projection.mjs --validate-config",
    "canon:check": "node scripts/sync-canon-projection.mjs --check",
    "canon:sync": "node scripts/sync-canon-projection.mjs --write",
    "build": "npm run canon:validate && tsc --noEmit && vite build && node scripts/render-route-metadata.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "posthog-js": "1.430.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.129.1"
  }
}
