{
  "name": "anevum-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run sync:seasonal && npm run sync:releases && npm run sync:share-image && npm run check && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "sync:seasonal": "python scripts/generate-seasonal-avatar.py",
    "sync:releases": "node scripts/sync-release-artifacts.mjs",
    "sync:share-image": "node scripts/sync-share-image.mjs",
    "validate:releases": "node scripts/validate-release-registry.mjs"
  },
  "dependencies": {
    "motion": "13.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.59.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.135.0"
  }
}
