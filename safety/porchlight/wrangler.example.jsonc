{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anevum-porchlight-v001-review",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "PORCHLIGHT_PUBLIC_ENABLED": "false",
    "PORCHLIGHT_HOST_SUBMISSIONS_ENABLED": "false",
    "PORCHLIGHT_ADMIN_ENABLED": "false"
  },
  "d1_databases": [
    { "binding": "PORCHLIGHT_DB", "database_name": "anevum-porchlight-isolated",
      "database_id": "REPLACE_WITH_SEPARATE_PORCHLIGHT_D1" }
  ],
  "triggers": { "crons": ["0 5 * * *"] }
}
